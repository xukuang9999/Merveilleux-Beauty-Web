<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 420 96" role="img" aria-labelledby="logo-title logo-desc">
  <title id="logo-title">MÉRVÉILLÉUX Premium wordmark</title>
  <desc id="logo-desc">Centered bronze metallic wordmark with premium subtitle and fine champagne hairlines.</desc>
  <defs>
    <linearGradient id="bronze-metal" x1="0" y1="0" x2="420" y2="0" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#8A7355"/>
      <stop offset="0.5" stop-color="#C0AA82"/>
      <stop offset="1" stop-color="#8A7355"/>
    </linearGradient>
  </defs>
  <text x="210" y="45" text-anchor="middle" font-family="'Avenir Next', Jost, Montserrat, Helvetica, Arial, sans-serif" font-size="31" font-weight="300" letter-spacing="8" fill="url(#bronze-metal)">MÉRVÉILLÉUX</text>
  <line x1="62" y1="68" x2="122" y2="68" stroke="#A08C68" stroke-width="0.75" opacity="0.6" stroke-linecap="round"/>
  <text x="210" y="72" text-anchor="middle" font-family="'Avenir Next', Jost, Montserrat, Helvetica, Arial, sans-serif" font-size="10" font-weight="300" letter-spacing="6" fill="#A08C68">P R E M I U M</text>
  <line x1="298" y1="68" x2="358" y2="68" stroke="#A08C68" stroke-width="0.75" opacity="0.6" stroke-linecap="round"/>
</svg>
