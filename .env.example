# Optional for the public curated catalogue. Required for accounts, admin,
# saved enquiries/subscriptions, training progress, and shared rate limits.
DATABASE_URL=postgresql://postgres:replace-with-your-password@localhost:5432/merveilleux
# Use a direct/session connection for Drizzle DDL when DATABASE_URL is a pooler.
DIRECT_DATABASE_URL=

# Optional AI and persistent Vercel image storage.
ANTHROPIC_API_KEY=
BLOB_READ_WRITE_TOKEN=

# One-time owner creation on a new database. Set an original strong password.
# Seed never changes an existing owner's account or password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Site Owner

# Optional development fixtures: permitted only on a loopback DB outside production.
SEED_DEMO_USERS=0
